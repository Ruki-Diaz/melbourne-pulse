# For running the pipeline locally. In GitHub these are repository secrets.

# Neon *pooled* connection string for the database owner role
DATABASE_URL=postgresql://<owner>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# Google AI Studio key (free tier). Optional: without it summary.py uses a template sentence.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
