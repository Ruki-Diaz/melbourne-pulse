# Copy to .env.local for local dev; set the same in Vercel -> Settings -> Environment Variables.
# Server-only: never prefix these with NEXT_PUBLIC_.

# Neon pooled connection string for the read-only `web_reader` role (see pipeline/schema.sql)
DATABASE_URL_READONLY=postgresql://web_reader:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# Shared with the GitHub Action that calls POST /api/revalidate. Generate: openssl rand -hex 32
REVALIDATE_SECRET=
